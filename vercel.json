{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|favicon|robots.txt|sitemap.xml|static-loader-data).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/:file(static-loader-data-manifest-.*\\.json)",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/static-loader-data/:path*",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
